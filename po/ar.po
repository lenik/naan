#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "الرخصة AGPL-3.0-or-later: جنو أغبل الإصدار 3 أو أحدث"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "الاستخدام: %s [خيار]... اسم...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "يحسب رقمًا من كل اسم."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "تجزئة بـ MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "تجزئة بـ SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "تجزئة بـ SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "تجزئة بـ SHA-256 (الافتراضي)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "تجزئة بـ SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "تجزئة بـ SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "تجزئة بـ SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "تجزئة بـ SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "تجزئة بـ BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "تجزئة بـ BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "تجزئة بـ RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "خلاصة CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "خلاصة CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "باقي القسمة (الافتراضي: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "يُضاف بعد الاختزال (الافتراضي: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "ملف تعريف التجزئة والنطاق (الافتراضي: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "عرض هذه المساعدة والخروج\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "عرض معلومات الإصدار والخروج\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "كل سطر من المخرجات هو:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "الملفات:"

#: src/naan.c:81
msgid "default"
msgstr "الافتراضي"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "يقبل DIV وBIAS العدد العشري أو الست عشري 0x، مع لاحقة k/m/g اختيارية (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV غير صالح: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS غير صالح: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: ملف غير معروف: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "جرّب «%s --help» لمزيد من المعلومات.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: الاسم مفقود\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: يجب أن يكون DIV أكبر من 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: تعذّر حساب الرقم لـ «%s»\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: خطأ في الكتابة\n"
