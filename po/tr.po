msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Lisans AGPL-3.0-or-later: GNU AGPL sürüm 3 veya sonrası"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Kullanım: %s [SEÇENEK]... AD...\n"

msgid "Compute a number from each name."
msgstr "Her addan bir sayı hesaplar."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           MD5 ile özetle"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          SHA-1 ile özetle"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        SHA-224 ile özetle"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        SHA-256 ile özetle (varsayılan)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        SHA-384 ile özetle"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        SHA-512 ile özetle"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      SHA3-256 ile özetle"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      SHA3-512 ile özetle"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       BLAKE2s ile özetle"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       BLAKE2b ile özetle"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     RIPEMD-160 ile özetle"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         CRC-16 özeti"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         CRC-32 özeti"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (varsayılan: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     indirgemeden sonra eklenir (varsayılan: 0)"

msgid "  -p, --profile NAME  range profile (default: w)"
msgstr "  -p, --profile NAME  aralık profili (varsayılan: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          bu yardımı göster ve çık"

msgid "      --version       output version information and exit"
msgstr "      --version       sürümü göster ve çık"

msgid "Each output line is:"
msgstr "Her çıktı satırı:"

msgid "Profiles:"
msgstr "Profiller:"

msgid "default"
msgstr "varsayılan"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV ve BIAS ondalık veya 0x onaltılık kabul eder; isteğe bağlı k/m/g soneki (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Daha fazla bilgi için '%s --help' deneyin.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: geçersiz DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: geçersiz BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: bilinmeyen profil: %s\n"

msgid "%s: missing name\n"
msgstr "%s: ad eksik\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV 0'dan büyük olmalıdır\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: '%s' için sayı hesaplanamadı\n"

msgid "%s: write error\n"
msgstr "%s: yazma hatası\n"
