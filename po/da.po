msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licens AGPL-3.0-or-later: GNU AGPL version 3 eller senere"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Brug: %s [TILVALG]... NAVN...\n"

msgid "Compute a number from each name."
msgstr "Beregner et tal fra hvert navn."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           hash med MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          hash med SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        hash med SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        hash med SHA-256 (standard)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        hash med SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        hash med SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      hash med SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      hash med SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       hash med BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       hash med BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     hash med RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         digest med CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         digest med CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (standard: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     lagt til efter reduktion (standard: 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  hash- og intervalprofil (standard: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          vis denne hjælp og afslut"

msgid "      --version       output version information and exit"
msgstr "      --version       vis versionsinformation og afslut"

msgid "Each output line is:"
msgstr "Hver uddatalinje er:"

msgid "Profiles:"
msgstr "Profiler:"

msgid "default"
msgstr "standard"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV og BIAS accepterer decimal eller 0x-hexadecimal, med valgfrit k/m/g-suffiks (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Prøv \"%s --help\" for mere information.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: ugyldig DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: ugyldig BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: ukendt profil: %s\n"

msgid "%s: missing name\n"
msgstr "%s: navn mangler\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV skal være større end 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: kunne ikke beregne tal for \"%s\"\n"

msgid "%s: write error\n"
msgstr "%s: skrivefejl\n"
