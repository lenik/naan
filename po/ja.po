#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "ライセンス AGPL-3.0-or-later: GNU AGPL バージョン 3 以降"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "用法: %s [オプション]... 名前...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "各名前から数値を求めます。"

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "MD5 でハッシュ\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "SHA-1 でハッシュ\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "SHA-224 でハッシュ\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "SHA-256 でハッシュ（既定）\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "SHA-384 でハッシュ\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "SHA-512 でハッシュ\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "SHA3-256 でハッシュ\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "SHA3-512 でハッシュ\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "BLAKE2s でハッシュ\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "BLAKE2b でハッシュ\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "RIPEMD-160 でハッシュ\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "CRC-16 ダイジェスト\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "CRC-32 ダイジェスト\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "剰余（既定: 65536）\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "剰余の後に加算（既定: 0）\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "ハッシュと範囲のプロファイル（既定: w）\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "このヘルプを表示して終了\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "バージョンを表示して終了\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "各出力行は次のとおりです:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "プロファイル:"

#: src/naan.c:81
msgid "default"
msgstr "既定"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV と BIAS は十進または 0x 十六進を受け付け、任意で k/m/g 接尾辞（1024）を付けられます。"

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: 無効な DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: 無効な BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: 未知のプロファイル: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "詳細は「%s --help」を試してください。\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: 名前がありません\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV は 0 より大きくなければなりません\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: 「%s」の数値を計算できませんでした\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: 書き込みエラー\n"
