#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Лицензия AGPL-3.0-or-later: GNU AGPL 3-нші нұсқасы немесе кейінгі"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Қолданылуы: %s [ОПЦИЯ]... АТАУ...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Әр атаудан сан есептейді."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "MD5 арқылы хештеу\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "SHA-1 арқылы хештеу\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "SHA-224 арқылы хештеу\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "SHA-256 арқылы хештеу (әдепкі)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "SHA-384 арқылы хештеу\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "SHA-512 арқылы хештеу\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "SHA3-256 арқылы хештеу\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "SHA3-512 арқылы хештеу\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "BLAKE2s арқылы хештеу\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "BLAKE2b арқылы хештеу\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "RIPEMD-160 арқылы хештеу\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "CRC-16 дайджесті\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "CRC-32 дайджесті\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "модуль (әдепкі: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "қысқартудан кейін қосылады (әдепкі: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "хеш және аралық профилі (әдепкі: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "осы анықтаманы көрсетіп шығу\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "нұсқаны көрсетіп шығу\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Әр шығыс жолы:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Профильдер:"

#: src/naan.c:81
msgid "default"
msgstr "әдепкі"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV және BIAS ондық немесе 0x оналтылықты қабылдайды, қосымша k/m/g жұрнағымен (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: жарамсыз DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: жарамсыз BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: белгісіз профиль: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Қосымша ақпарат үшін «%s --help» қолданып көріңіз.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: атау жоқ\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV 0-ден үлкен болуы керек\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: «%s» үшін сан есептелмеді\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: жазу қатесі\n"
