msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Lisenssi AGPL-3.0-or-later: GNU AGPL versio 3 tai uudempi"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Käyttö: %s [VALITSIN]... NIMI...\n"

msgid "Compute a number from each name."
msgstr "Laskee luvun jokaisesta nimestä."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           tiivistä MD5:lla"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          tiivistä SHA-1:lla"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        tiivistä SHA-224:lla"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        tiivistä SHA-256:lla (oletus)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        tiivistä SHA-384:lla"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        tiivistä SHA-512:lla"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      tiivistä SHA3-256:lla"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      tiivistä SHA3-512:lla"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       tiivistä BLAKE2s:lla"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       tiivistä BLAKE2b:lla"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     tiivistä RIPEMD-160:lla"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         tiiviste CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         tiiviste CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (oletus: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     lisätään vähennyksen jälkeen (oletus: 0)"

msgid "  -p, --profile NAME  range profile (default: w)"
msgstr "  -p, --profile NAME  alueprofiili (oletus: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          näytä tämä ohje ja poistu"

msgid "      --version       output version information and exit"
msgstr "      --version       näytä versiontiedot ja poistu"

msgid "Each output line is:"
msgstr "Jokainen tulostusrivi on:"

msgid "Profiles:"
msgstr "Profiilit:"

msgid "default"
msgstr "oletus"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV ja BIAS hyväksyvät kymmen- tai 0x-16-järjestelmän, valinnaisesti k/m/g-jälkiliitteellä (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Lisätietoja: %s --help\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: virheellinen DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: virheellinen BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: tuntematon profiili: %s\n"

msgid "%s: missing name\n"
msgstr "%s: nimi puuttuu\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV:n on oltava suurempi kuin 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: luvun laskeminen epäonnistui kohteelle '%s'\n"

msgid "%s: write error\n"
msgstr "%s: kirjoitusvirhe\n"
