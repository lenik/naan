#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "สัญญาอนุญาต AGPL-3.0-or-later: GNU AGPL รุ่น 3 หรือใหม่กว่า"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "วิธีใช้: %s [ตัวเลือก]... ชื่อ...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "คำนวณตัวเลขจากแต่ละชื่อ"

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "แฮชด้วย MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "แฮชด้วย SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "แฮชด้วย SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "แฮชด้วย SHA-256 (ค่าเริ่มต้น)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "แฮชด้วย SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "แฮชด้วย SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "แฮชด้วย SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "แฮชด้วย SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "แฮชด้วย BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "แฮชด้วย BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "แฮชด้วย RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "ไดเจสต์ CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "ไดเจสต์ CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "มอดูลัส (ค่าเริ่มต้น: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "บวกหลังลดทอน (ค่าเริ่มต้น: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "โปรไฟล์แฮชและช่วง (ค่าเริ่มต้น: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "แสดงความช่วยเหลือนี้แล้วออก\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "แสดงรุ่นแล้วออก\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "แต่ละบรรทัดผลลัพธ์คือ:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "โปรไฟล์:"

#: src/naan.c:81
msgid "default"
msgstr "ค่าเริ่มต้น"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV และ BIAS รับเลขฐานสิบหรือฐานสิบหก 0x และอาจมีคำต่อท้าย k/m/g (1024)"

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV ไม่ถูกต้อง: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS ไม่ถูกต้อง: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: ไม่รู้จักโปรไฟล์: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "ลอง '%s --help' สำหรับข้อมูลเพิ่มเติม\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: ไม่มีชื่อ\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV ต้องมากกว่า 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: คำนวณตัวเลขสำหรับ '%s' ไม่สำเร็จ\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: ข้อผิดพลาดในการเขียน\n"
