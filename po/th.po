msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "สัญญาอนุญาต AGPL-3.0-or-later: GNU AGPL รุ่น 3 หรือใหม่กว่า"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "วิธีใช้: %s [ตัวเลือก]... ชื่อ...\n"

msgid "Compute a number from each name."
msgstr "คำนวณตัวเลขจากแต่ละชื่อ"

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           แฮชด้วย MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          แฮชด้วย SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        แฮชด้วย SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        แฮชด้วย SHA-256 (ค่าเริ่มต้น)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        แฮชด้วย SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        แฮชด้วย SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      แฮชด้วย SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      แฮชด้วย SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       แฮชด้วย BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       แฮชด้วย BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     แฮชด้วย RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         ไดเจสต์ CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         ไดเจสต์ CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       มอดูลัส (ค่าเริ่มต้น: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     บวกหลังลดทอน (ค่าเริ่มต้น: 0)"

msgid "  -p, --profile NAME  range profile (default: w)"
msgstr "  -p, --profile NAME  โปรไฟล์ช่วง (ค่าเริ่มต้น: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          แสดงความช่วยเหลือนี้แล้วออก"

msgid "      --version       output version information and exit"
msgstr "      --version       แสดงรุ่นแล้วออก"

msgid "Each output line is:"
msgstr "แต่ละบรรทัดผลลัพธ์คือ:"

msgid "Profiles:"
msgstr "โปรไฟล์:"

msgid "default"
msgstr "ค่าเริ่มต้น"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV และ BIAS รับเลขฐานสิบหรือฐานสิบหก 0x และอาจมีคำต่อท้าย k/m/g (1024)"

msgid "Try '%s --help' for more information.\n"
msgstr "ลอง '%s --help' สำหรับข้อมูลเพิ่มเติม\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV ไม่ถูกต้อง: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS ไม่ถูกต้อง: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: ไม่รู้จักโปรไฟล์: %s\n"

msgid "%s: missing name\n"
msgstr "%s: ไม่มีชื่อ\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV ต้องมากกว่า 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: คำนวณตัวเลขสำหรับ '%s' ไม่สำเร็จ\n"

msgid "%s: write error\n"
msgstr "%s: ข้อผิดพลาดในการเขียน\n"
