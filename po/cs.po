#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licence AGPL-3.0-or-later: GNU AGPL verze 3 nebo novější"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Použití: %s [PŘEPÍNAČ]... JMÉNO...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Vypočítá číslo z každého jména."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "hashovat MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "hashovat SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "hashovat SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "hashovat SHA-256 (výchozí)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "hashovat SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "hashovat SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "hashovat SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "hashovat SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "hashovat BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "hashovat BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "hashovat RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "digest CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "digest CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "modulus (výchozí: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "přidáno po redukci (výchozí: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "profil hashe a rozsahu (výchozí: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "zobrazit tuto nápovědu a skončit\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "zobrazit verzi a skončit\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Každý výstupní řádek je:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Profily:"

#: src/naan.c:81
msgid "default"
msgstr "výchozí"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV a BIAS přijímají desítkový nebo 0x šestnáctkový zápis, volitelně s příponou k/m/g (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: neplatné DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: neplatné BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: neznámý profil: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Pro více informací zkuste „%s --help“.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: chybí jméno\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV musí být větší než 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: nelze vypočítat číslo pro „%s“\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: chyba zápisu\n"
