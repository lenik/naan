#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licență AGPL-3.0-or-later: GNU AGPL versiunea 3 sau ulterioară"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Utilizare: %s [OPȚIUNE]... NUME...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Calculează un număr din fiecare nume."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "hash cu MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "hash cu SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "hash cu SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "hash cu SHA-256 (implicit)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "hash cu SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "hash cu SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "hash cu SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "hash cu SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "hash cu BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "hash cu BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "hash cu RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "digest CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "digest CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "modul (implicit: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "adăugat după reducere (implicit: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "profil de hash și interval (implicit: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "afișează acest ajutor și ieși\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "afișează versiunea și ieși\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Fiecare linie de ieșire este:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Profiluri:"

#: src/naan.c:81
msgid "default"
msgstr "implicit"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV și BIAS acceptă zecimal sau hexazecimal 0x, cu sufix opțional k/m/g (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV nevalid: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS nevalid: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: profil necunoscut: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Încercați „%s --help” pentru mai multe informații.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: lipsește numele\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV trebuie să fie mai mare decât 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: nu s-a putut calcula numărul pentru „%s”\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: eroare de scriere\n"
