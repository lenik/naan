#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licencia AGPL-3.0-or-later: GNU AGPL versión 3 o posterior"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Uso: %s [OPCIÓN]... NOMBRE...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Calcula un número a partir de cada nombre."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "resumir con MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "resumir con SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "resumir con SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "resumir con SHA-256 (predeterminado)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "resumir con SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "resumir con SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "resumir con SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "resumir con SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "resumir con BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "resumir con BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "resumir con RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "resumen CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "resumen CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "módulo (predeterminado: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "se suma después de la reducción (predeterminado: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "perfil de hash y rango (predeterminado: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "mostrar esta ayuda y salir\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "mostrar la versión y salir\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Cada línea de salida es:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Perfiles:"

#: src/naan.c:81
msgid "default"
msgstr "predeterminado"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV y BIAS aceptan decimal o hexadecimal 0x, con sufijo k/m/g opcional (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV no válido: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS no válido: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: perfil desconocido: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Pruebe «%s --help» para más información.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: falta el nombre\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV debe ser mayor que 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: no se pudo calcular el número para «%s»\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: error de escritura\n"
