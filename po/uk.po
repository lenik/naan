#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Ліцензія AGPL-3.0-or-later: GNU AGPL версії 3 або новішої"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Використання: %s [ПАРАМЕТР]... ІМ'Я...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Обчислює число з кожного імені."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "хешувати MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "хешувати SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "хешувати SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "хешувати SHA-256 (типово)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "хешувати SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "хешувати SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "хешувати SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "хешувати SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "хешувати BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "хешувати BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "хешувати RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "дайджест CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "дайджест CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "модуль (типово: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "додається після зведення (типово: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "профіль хешу та діапазону (типово: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "показати цю довідку і вийти\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "показати версію і вийти\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Кожен рядок виводу:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Профілі:"

#: src/naan.c:81
msgid "default"
msgstr "типово"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV і BIAS приймають десятковий або 0x шістнадцятковий запис, з необов'язковим суфіксом k/m/g (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: недійсний DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: недійсний BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: невідомий профіль: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Спробуйте «%s --help» для докладнішої інформації.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: відсутнє ім'я\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV має бути більшим за 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: не вдалося обчислити число для «%s»\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: помилка запису\n"
