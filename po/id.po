msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Lisensi AGPL-3.0-or-later: GNU AGPL versi 3 atau lebih baru"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Pemakaian: %s [OPSI]... NAMA...\n"

msgid "Compute a number from each name."
msgstr "Menghitung sebuah angka dari setiap nama."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           hash dengan MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          hash dengan SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        hash dengan SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        hash dengan SHA-256 (baku)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        hash dengan SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        hash dengan SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      hash dengan SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      hash dengan SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       hash dengan BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       hash dengan BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     hash dengan RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         digest CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         digest CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (baku: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     ditambah setelah reduksi (baku: 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  profil hash dan rentang (baku: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          tampilkan bantuan ini dan keluar"

msgid "      --version       output version information and exit"
msgstr "      --version       tampilkan versi dan keluar"

msgid "Each output line is:"
msgstr "Setiap baris keluaran adalah:"

msgid "Profiles:"
msgstr "Profil:"

msgid "default"
msgstr "baku"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV dan BIAS menerima desimal atau heksadesimal 0x, dengan akhiran k/m/g opsional (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Coba '%s --help' untuk informasi lebih lanjut.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV tidak sah: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS tidak sah: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: profil tidak dikenal: %s\n"

msgid "%s: missing name\n"
msgstr "%s: nama hilang\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV harus lebih besar dari 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: gagal menghitung angka untuk '%s'\n"

msgid "%s: write error\n"
msgstr "%s: kesalahan tulis\n"
