#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Άδεια AGPL-3.0-or-later: GNU AGPL έκδοση 3 ή νεότερη"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Χρήση: %s [ΕΠΙΛΟΓΗ]... ΟΝΟΜΑ...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Υπολογίζει έναν αριθμό από κάθε όνομα."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "κατακερματισμός με MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "κατακερματισμός με SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "κατακερματισμός με SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "κατακερματισμός με SHA-256 (προεπιλογή)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "κατακερματισμός με SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "κατακερματισμός με SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "κατακερματισμός με SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "κατακερματισμός με SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "κατακερματισμός με BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "κατακερματισμός με BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "κατακερματισμός με RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "σύνοψη CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "σύνοψη CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "modulus (προεπιλογή: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "προστίθεται μετά τη μείωση (προεπιλογή: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "προφίλ κατακερματισμού και εύρους (προεπιλογή: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "εμφάνιση αυτής της βοήθειας και έξοδος\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "εμφάνιση έκδοσης και έξοδος\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Κάθε γραμμή εξόδου είναι:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Προφίλ:"

#: src/naan.c:81
msgid "default"
msgstr "προεπιλογή"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "Τα DIV και BIAS δέχονται δεκαδικό ή δεκαεξαδικό 0x, με προαιρετικό επίθημα k/m/g (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: μη έγκυρο DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: μη έγκυρο BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: άγνωστο προφίλ: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Δοκιμάστε «%s --help» για περισσότερες πληροφορίες.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: λείπει το όνομα\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: το DIV πρέπει να είναι μεγαλύτερο από 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: αποτυχία υπολογισμού αριθμού για «%s»\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: σφάλμα εγγραφής\n"
