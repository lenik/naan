msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Άδεια AGPL-3.0-or-later: GNU AGPL έκδοση 3 ή νεότερη"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Χρήση: %s [ΕΠΙΛΟΓΗ]... ΟΝΟΜΑ...\n"

msgid "Compute a number from each name."
msgstr "Υπολογίζει έναν αριθμό από κάθε όνομα."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           κατακερματισμός με MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          κατακερματισμός με SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        κατακερματισμός με SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        κατακερματισμός με SHA-256 (προεπιλογή)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        κατακερματισμός με SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        κατακερματισμός με SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      κατακερματισμός με SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      κατακερματισμός με SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       κατακερματισμός με BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       κατακερματισμός με BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     κατακερματισμός με RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         σύνοψη CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         σύνοψη CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (προεπιλογή: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     προστίθεται μετά τη μείωση (προεπιλογή: 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  προφίλ κατακερματισμού και εύρους (προεπιλογή: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          εμφάνιση αυτής της βοήθειας και έξοδος"

msgid "      --version       output version information and exit"
msgstr "      --version       εμφάνιση έκδοσης και έξοδος"

msgid "Each output line is:"
msgstr "Κάθε γραμμή εξόδου είναι:"

msgid "Profiles:"
msgstr "Προφίλ:"

msgid "default"
msgstr "προεπιλογή"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "Τα DIV και BIAS δέχονται δεκαδικό ή δεκαεξαδικό 0x, με προαιρετικό επίθημα k/m/g (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Δοκιμάστε «%s --help» για περισσότερες πληροφορίες.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: μη έγκυρο DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: μη έγκυρο BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: άγνωστο προφίλ: %s\n"

msgid "%s: missing name\n"
msgstr "%s: λείπει το όνομα\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: το DIV πρέπει να είναι μεγαλύτερο από 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: αποτυχία υπολογισμού αριθμού για «%s»\n"

msgid "%s: write error\n"
msgstr "%s: σφάλμα εγγραφής\n"
