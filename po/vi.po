msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Giấy phép AGPL-3.0-or-later: GNU AGPL phiên bản 3 trở lên"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Cách dùng: %s [TÙY CHỌN]... TÊN...\n"

msgid "Compute a number from each name."
msgstr "Tính một số từ mỗi tên."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           băm bằng MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          băm bằng SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        băm bằng SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        băm bằng SHA-256 (mặc định)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        băm bằng SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        băm bằng SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      băm bằng SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      băm bằng SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       băm bằng BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       băm bằng BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     băm bằng RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         tóm tắt CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         tóm tắt CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (mặc định: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     cộng sau khi rút gọn (mặc định: 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  hồ sơ hàm băm và phạm vi (mặc định: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          hiện trợ giúp này rồi thoát"

msgid "      --version       output version information and exit"
msgstr "      --version       hiện phiên bản rồi thoát"

msgid "Each output line is:"
msgstr "Mỗi dòng xuất là:"

msgid "Profiles:"
msgstr "Hồ sơ:"

msgid "default"
msgstr "mặc định"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV và BIAS nhận thập phân hoặc thập lục phân 0x, với hậu tố k/m/g tùy chọn (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Thử '%s --help' để biết thêm.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV không hợp lệ: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS không hợp lệ: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: hồ sơ không rõ: %s\n"

msgid "%s: missing name\n"
msgstr "%s: thiếu tên\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV phải lớn hơn 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: không tính được số cho '%s'\n"

msgid "%s: write error\n"
msgstr "%s: lỗi ghi\n"
