msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Лицензия AGPL-3.0-or-later: GNU AGPL версии 3 или новее"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Использование: %s [ПАРАМЕТР]... ИМЯ...\n"

msgid "Compute a number from each name."
msgstr "Вычисляет число из каждого имени."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           хешировать MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          хешировать SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        хешировать SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        хешировать SHA-256 (по умолчанию)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        хешировать SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        хешировать SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      хешировать SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      хешировать SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       хешировать BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       хешировать BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     хешировать RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         дайджест CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         дайджест CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       модуль (по умолчанию: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     добавляется после сведения (по умолчанию: 0)"

msgid "  -p, --profile NAME  range profile (default: w)"
msgstr "  -p, --profile NAME  профиль диапазона (по умолчанию: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          показать эту справку и выйти"

msgid "      --version       output version information and exit"
msgstr "      --version       показать версию и выйти"

msgid "Each output line is:"
msgstr "Каждая строка вывода:"

msgid "Profiles:"
msgstr "Профили:"

msgid "default"
msgstr "по умолчанию"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV и BIAS принимают десятичную или 0x-шестнадцатеричную запись с необязательным суффиксом k/m/g (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Попробуйте «%s --help» для справки.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: недопустимый DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: недопустимый BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: неизвестный профиль: %s\n"

msgid "%s: missing name\n"
msgstr "%s: отсутствует имя\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV должен быть больше 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: не удалось вычислить число для «%s»\n"

msgid "%s: write error\n"
msgstr "%s: ошибка записи\n"
