#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licentie AGPL-3.0-or-later: GNU AGPL versie 3 of later"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Gebruik: %s [OPTIE]... NAAM...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Berekent een getal uit elke naam."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "hashen met MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "hashen met SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "hashen met SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "hashen met SHA-256 (standaard)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "hashen met SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "hashen met SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "hashen met SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "hashen met SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "hashen met BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "hashen met BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "hashen met RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "digest met CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "digest met CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "modulus (standaard: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "opgeteld na reductie (standaard: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "hash- en bereikprofiel (standaard: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "deze hulp tonen en afsluiten\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "versie tonen en afsluiten\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Elke uitvoerregel is:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Profielen:"

#: src/naan.c:81
msgid "default"
msgstr "standaard"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV en BIAS aanvaarden decimaal of 0x-hexadecimaal, optioneel met k/m/g-achtervoegsel (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: ongeldige DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: ongeldige BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: onbekend profiel: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Probeer '%s --help' voor meer informatie.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: naam ontbreekt\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV moet groter zijn dan 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: kon getal voor '%s' niet berekenen\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: schrijffout\n"
