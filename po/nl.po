msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licentie AGPL-3.0-or-later: GNU AGPL versie 3 of later"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Gebruik: %s [OPTIE]... NAAM...\n"

msgid "Compute a number from each name."
msgstr "Berekent een getal uit elke naam."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           hashen met MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          hashen met SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        hashen met SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        hashen met SHA-256 (standaard)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        hashen met SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        hashen met SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      hashen met SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      hashen met SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       hashen met BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       hashen met BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     hashen met RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         digest met CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         digest met CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (standaard: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     opgeteld na reductie (standaard: 0)"

msgid "  -p, --profile NAME  range profile (default: w)"
msgstr "  -p, --profile NAME  bereikprofiel (standaard: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          deze hulp tonen en afsluiten"

msgid "      --version       output version information and exit"
msgstr "      --version       versie tonen en afsluiten"

msgid "Each output line is:"
msgstr "Elke uitvoerregel is:"

msgid "Profiles:"
msgstr "Profielen:"

msgid "default"
msgstr "standaard"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV en BIAS aanvaarden decimaal of 0x-hexadecimaal, optioneel met k/m/g-achtervoegsel (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Probeer '%s --help' voor meer informatie.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: ongeldige DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: ongeldige BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: onbekend profiel: %s\n"

msgid "%s: missing name\n"
msgstr "%s: naam ontbreekt\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV moet groter zijn dan 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: kon getal voor '%s' niet berekenen\n"

msgid "%s: write error\n"
msgstr "%s: schrijffout\n"
