#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "רישיון AGPL-3.0-or-later: GNU AGPL גרסה 3 ואילך"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "שימוש: %s [אפשרות]... שם...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "מחשב מספר מכל שם."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "גיבוב עם MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "גיבוב עם SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "גיבוב עם SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "גיבוב עם SHA-256 (ברירת מחדל)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "גיבוב עם SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "גיבוב עם SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "גיבוב עם SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "גיבוב עם SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "גיבוב עם BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "גיבוב עם BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "גיבוב עם RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "תמצית CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "תמצית CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "מודולוס (ברירת מחדל: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "מתווסף אחרי הצמצום (ברירת מחדל: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "פרופיל גיבוב וטווח (ברירת מחדל: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "הצג עזרה זו וצא\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "הצג גרסה וצא\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "כל שורת פלט היא:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "פרופילים:"

#: src/naan.c:81
msgid "default"
msgstr "ברירת מחדל"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV ו-BIAS מקבלים עשרוני או hex עם 0x, עם סיומת k/m/g רשות (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV לא תקין: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS לא תקין: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: פרופיל לא ידוע: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "נסו '%s --help' למידע נוסף.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: חסר שם\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV חייב להיות גדול מ-0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: חישוב המספר עבור '%s' נכשל\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: שגיאת כתיבה\n"
