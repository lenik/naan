#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Lizenz AGPL-3.0-or-later: GNU AGPL Version 3 oder später"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Aufruf: %s [OPTION]... NAME...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Berechnet eine Zahl aus jedem Namen."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "mit MD5 hashen\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "mit SHA-1 hashen\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "mit SHA-224 hashen\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "mit SHA-256 hashen (Standard)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "mit SHA-384 hashen\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "mit SHA-512 hashen\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "mit SHA3-256 hashen\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "mit SHA3-512 hashen\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "mit BLAKE2s hashen\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "mit BLAKE2b hashen\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "mit RIPEMD-160 hashen\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "Digest mit CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "Digest mit CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "Modul (Standard: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "nach der Reduktion addiert (Standard: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "Hash- und Bereichsprofil (Standard: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "diese Hilfe anzeigen und beenden\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "Versionsinformation ausgeben und beenden\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Jede Ausgabezeile ist:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Profile:"

#: src/naan.c:81
msgid "default"
msgstr "Standard"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV und BIAS akzeptieren Dezimal oder 0x-Hexadezimal, optional mit k/m/g-Suffix (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: ungültiges DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: ungültiges BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: unbekanntes Profil: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Versuchen Sie „%s --help“ für weitere Informationen.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: Name fehlt\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV muss größer als 0 sein\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: Zahl für „%s“ konnte nicht berechnet werden\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: Schreibfehler\n"
