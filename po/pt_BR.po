#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licença AGPL-3.0-or-later: GNU AGPL versão 3 ou posterior"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Uso: %s [OPÇÃO]... NOME...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Calcula um número a partir de cada nome."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "calcular hash com MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "calcular hash com SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "calcular hash com SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "calcular hash com SHA-256 (padrão)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "calcular hash com SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "calcular hash com SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "calcular hash com SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "calcular hash com SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "calcular hash com BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "calcular hash com BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "calcular hash com RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "digest CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "digest CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "módulo (padrão: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "somado após a redução (padrão: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "perfil de hash e intervalo (padrão: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "mostrar esta ajuda e sair\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "mostrar a versão e sair\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Cada linha de saída é:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Perfis:"

#: src/naan.c:81
msgid "default"
msgstr "padrão"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV e BIAS aceitam decimal ou hexadecimal 0x, com sufixo k/m/g opcional (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV inválido: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS inválido: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: perfil desconhecido: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Tente '%s --help' para mais informações.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: nome ausente\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV deve ser maior que 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: falha ao calcular o número de '%s'\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: erro de escrita\n"
