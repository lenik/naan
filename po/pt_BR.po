msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licença AGPL-3.0-or-later: GNU AGPL versão 3 ou posterior"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Uso: %s [OPÇÃO]... NOME...\n"

msgid "Compute a number from each name."
msgstr "Calcula um número a partir de cada nome."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           calcular hash com MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          calcular hash com SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        calcular hash com SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        calcular hash com SHA-256 (padrão)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        calcular hash com SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        calcular hash com SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      calcular hash com SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      calcular hash com SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       calcular hash com BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       calcular hash com BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     calcular hash com RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         digest CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         digest CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       módulo (padrão: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     somado após a redução (padrão: 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  perfil de hash e intervalo (padrão: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          mostrar esta ajuda e sair"

msgid "      --version       output version information and exit"
msgstr "      --version       mostrar a versão e sair"

msgid "Each output line is:"
msgstr "Cada linha de saída é:"

msgid "Profiles:"
msgstr "Perfis:"

msgid "default"
msgstr "padrão"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV e BIAS aceitam decimal ou hexadecimal 0x, com sufixo k/m/g opcional (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Tente '%s --help' para mais informações.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV inválido: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS inválido: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: perfil desconhecido: %s\n"

msgid "%s: missing name\n"
msgstr "%s: nome ausente\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV deve ser maior que 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: falha ao calcular o número de '%s'\n"

msgid "%s: write error\n"
msgstr "%s: erro de escrita\n"
