#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licence AGPL-3.0-or-later : GNU AGPL version 3 ou ultérieure"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Usage : %s [OPTION]... NOM...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Calcule un nombre à partir de chaque nom."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "hacher avec MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "hacher avec SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "hacher avec SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "hacher avec SHA-256 (défaut)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "hacher avec SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "hacher avec SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "hacher avec SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "hacher avec SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "hacher avec BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "hacher avec BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "hacher avec RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "condensé CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "condensé CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "module (défaut : 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "ajouté après la réduction (défaut : 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "profil de hachage et de plage (défaut : w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "afficher cette aide et quitter\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "afficher la version et quitter\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Chaque ligne de sortie est :"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Profils :"

#: src/naan.c:81
msgid "default"
msgstr "défaut"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV et BIAS acceptent le décimal ou l'hexadécimal 0x, avec un suffixe k/m/g optionnel (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s : DIV invalide : %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s : BIAS invalide : %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s : profil inconnu : %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Essayez « %s --help » pour plus d'informations.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s : nom manquant\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s : DIV doit être supérieur à 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s : échec du calcul du nombre pour « %s »\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s : erreur d'écriture\n"
