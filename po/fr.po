msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licence AGPL-3.0-or-later : GNU AGPL version 3 ou ultérieure"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Usage : %s [OPTION]... NOM...\n"

msgid "Compute a number from each name."
msgstr "Calcule un nombre à partir de chaque nom."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           hacher avec MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          hacher avec SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        hacher avec SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        hacher avec SHA-256 (défaut)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        hacher avec SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        hacher avec SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      hacher avec SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      hacher avec SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       hacher avec BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       hacher avec BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     hacher avec RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         condensé CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         condensé CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       module (défaut : 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     ajouté après la réduction (défaut : 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  profil de hachage et de plage (défaut : w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          afficher cette aide et quitter"

msgid "      --version       output version information and exit"
msgstr "      --version       afficher la version et quitter"

msgid "Each output line is:"
msgstr "Chaque ligne de sortie est :"

msgid "Profiles:"
msgstr "Profils :"

msgid "default"
msgstr "défaut"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV et BIAS acceptent le décimal ou l'hexadécimal 0x, avec un suffixe k/m/g optionnel (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Essayez « %s --help » pour plus d'informations.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s : DIV invalide : %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s : BIAS invalide : %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s : profil inconnu : %s\n"

msgid "%s: missing name\n"
msgstr "%s : nom manquant\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s : DIV doit être supérieur à 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s : échec du calcul du nombre pour « %s »\n"

msgid "%s: write error\n"
msgstr "%s : erreur d'écriture\n"
