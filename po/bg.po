msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Лиценз AGPL-3.0-or-later: GNU AGPL версия 3 или по-нова"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Употреба: %s [ОПЦИЯ]... ИМЕ...\n"

msgid "Compute a number from each name."
msgstr "Изчислява число от всяко име."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           хеширай с MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          хеширай с SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        хеширай с SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        хеширай с SHA-256 (по подразбиране)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        хеширай с SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        хеширай с SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      хеширай с SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      хеширай с SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       хеширай с BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       хеширай с BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     хеширай с RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         дайджест CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         дайджест CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       модул (по подразбиране: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     добавя се след свеждане (по подразбиране: 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  профил на хеш и диапазон (по подразбиране: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          покажи тази помощ и изход"

msgid "      --version       output version information and exit"
msgstr "      --version       покажи версията и изход"

msgid "Each output line is:"
msgstr "Всеки изходен ред е:"

msgid "Profiles:"
msgstr "Профили:"

msgid "default"
msgstr "по подразбиране"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV и BIAS приемат десетичен или 0x шестнадесетичен запис, с незадължителен наставка k/m/g (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Опитайте „%s --help“ за повече информация.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: невалиден DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: невалиден BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: неизвестен профил: %s\n"

msgid "%s: missing name\n"
msgstr "%s: липсва име\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV трябва да е по-голям от 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: неуспешно изчисляване на число за „%s“\n"

msgid "%s: write error\n"
msgstr "%s: грешка при запис\n"
