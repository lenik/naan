#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Lisensya AGPL-3.0-or-later: GNU AGPL bersyon 3 o mas bago"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Paggamit: %s [OPSYON]... PANGALAN...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Tumutukoy ng numero mula sa bawat pangalan."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "i-hash gamit ang MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "i-hash gamit ang SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "i-hash gamit ang SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "i-hash gamit ang SHA-256 (default)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "i-hash gamit ang SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "i-hash gamit ang SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "i-hash gamit ang SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "i-hash gamit ang SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "i-hash gamit ang BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "i-hash gamit ang BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "i-hash gamit ang RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "digest CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "digest CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "modulus (default: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "idinadagdag pagkatapos ng reduction (default: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "profile ng hash at sakop (default: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "ipakita ang tulong na ito at umalis\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "ipakita ang bersyon at umalis\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Ang bawat linya ng output ay:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Mga profile:"

#: src/naan.c:81
msgid "default"
msgstr "default"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "Tinatanggap ng DIV at BIAS ang decimal o 0x hex, na may opsyonal na k/m/g suffix (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: hindi wastong DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: hindi wastong BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: hindi kilalang profile: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Subukan ang '%s --help' para sa iba pang impormasyon.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: nawawala ang pangalan\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: ang DIV ay dapat mas malaki sa 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: nabigong kalkulahin ang numero para sa '%s'\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: error sa pagsulat\n"
