#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Lisens AGPL-3.0-or-later: GNU AGPL versjon 3 eller senere"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Bruk: %s [VALG]... NAVN...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Beregner et tall fra hvert navn."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "hash med MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "hash med SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "hash med SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "hash med SHA-256 (standard)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "hash med SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "hash med SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "hash med SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "hash med SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "hash med BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "hash med BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "hash med RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "digest med CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "digest med CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "modulus (standard: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "lagt til etter reduksjon (standard: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "hash- og områdeprofil (standard: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "vis denne hjelpen og avslutt\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "vis versjon og avslutt\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Hver utdatalinje er:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Profiler:"

#: src/naan.c:81
msgid "default"
msgstr "standard"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV og BIAS godtar desimal eller 0x-heksadesimal, med valgfritt k/m/g-suffiks (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: ugyldig DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: ugyldig BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: ukjent profil: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Prøv «%s --help» for mer informasjon.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: navn mangler\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV må være større enn 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: kunne ikke beregne tall for «%s»\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: skrivefeil\n"
