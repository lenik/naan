msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licenc AGPL-3.0-or-later: GNU AGPL 3. vagy újabb verzió"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Használat: %s [KAPCSOLÓ]... NÉV...\n"

msgid "Compute a number from each name."
msgstr "Számot számít minden névből."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           hash MD5 algoritmussal"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          hash SHA-1 algoritmussal"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        hash SHA-224 algoritmussal"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        hash SHA-256 algoritmussal (alapértelmezett)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        hash SHA-384 algoritmussal"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        hash SHA-512 algoritmussal"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      hash SHA3-256 algoritmussal"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      hash SHA3-512 algoritmussal"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       hash BLAKE2s algoritmussal"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       hash BLAKE2b algoritmussal"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     hash RIPEMD-160 algoritmussal"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         CRC-16 kivonat"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         CRC-32 kivonat"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulus (alapértelmezett: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     hozzáadva a redukció után (alapértelmezett: 0)"

msgid "  -p, --profile NAME  range profile (default: w)"
msgstr "  -p, --profile NAME  tartományprofil (alapértelmezett: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          súgó megjelenítése és kilépés"

msgid "      --version       output version information and exit"
msgstr "      --version       verzió kiírása és kilépés"

msgid "Each output line is:"
msgstr "Minden kimeneti sor:"

msgid "Profiles:"
msgstr "Profilok:"

msgid "default"
msgstr "alapértelmezett"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "A DIV és a BIAS tizes vagy 0x hexadecimális alakot fogad, opcionális k/m/g utótaggal (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "További információ: %s --help\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: érvénytelen DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: érvénytelen BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: ismeretlen profil: %s\n"

msgid "%s: missing name\n"
msgstr "%s: hiányzó név\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: a DIV-nek nagyobbnak kell lennie 0-nál\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: nem sikerült számot számítani erre: '%s'\n"

msgid "%s: write error\n"
msgstr "%s: írási hiba\n"
