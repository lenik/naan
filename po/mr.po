msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "परवाना AGPL-3.0-or-later: GNU AGPL आवृत्ती 3 किंवा नंतरची"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "वापर: %s [पर्याय]... नाव...\n"

msgid "Compute a number from each name."
msgstr "प्रत्येक नावातून एक संख्या काढतो."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           MD5 ने हॅश करा"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          SHA-1 ने हॅश करा"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        SHA-224 ने हॅश करा"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        SHA-256 ने हॅश करा (मुलभूत)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        SHA-384 ने हॅश करा"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        SHA-512 ने हॅश करा"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      SHA3-256 ने हॅश करा"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      SHA3-512 ने हॅश करा"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       BLAKE2s ने हॅश करा"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       BLAKE2b ने हॅश करा"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     RIPEMD-160 ने हॅश करा"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         CRC-16 डायजेस्ट"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         CRC-32 डायजेस्ट"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       मॉड्युलस (मुलभूत: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     घटानंतर जोडले जाते (मुलभूत: 0)"

msgid "  -p, --profile NAME  range profile (default: w)"
msgstr "  -p, --profile NAME  श्रेणी प्रोफाइल (मुलभूत: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          ही मदत दाखवा आणि बाहेर पडा"

msgid "      --version       output version information and exit"
msgstr "      --version       आवृत्ती दाखवा आणि बाहेर पडा"

msgid "Each output line is:"
msgstr "प्रत्येक आउटपुट ओळ:"

msgid "Profiles:"
msgstr "प्रोफाइल:"

msgid "default"
msgstr "मुलभूत"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV आणि BIAS दशमान किंवा 0x षोडशमान स्वीकारतात, वैकल्पिक k/m/g प्रत्ययासह (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "अधिक माहितीसाठी '%s --help' वापरा.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: अवैध DIV: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: अवैध BIAS: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: अज्ञात प्रोफाइल: %s\n"

msgid "%s: missing name\n"
msgstr "%s: नाव नाही\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV 0 पेक्षा मोठे असावे\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: '%s' ची संख्या काढता आली नाही\n"

msgid "%s: write error\n"
msgstr "%s: लेखन त्रुटी\n"
