#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "परवाना AGPL-3.0-or-later: GNU AGPL आवृत्ती 3 किंवा नंतरची"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "वापर: %s [पर्याय]... नाव...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "प्रत्येक नावातून एक संख्या काढतो."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "MD5 ने हॅश करा\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "SHA-1 ने हॅश करा\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "SHA-224 ने हॅश करा\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "SHA-256 ने हॅश करा (मुलभूत)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "SHA-384 ने हॅश करा\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "SHA-512 ने हॅश करा\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "SHA3-256 ने हॅश करा\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "SHA3-512 ने हॅश करा\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "BLAKE2s ने हॅश करा\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "BLAKE2b ने हॅश करा\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "RIPEMD-160 ने हॅश करा\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "CRC-16 डायजेस्ट\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "CRC-32 डायजेस्ट\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "मॉड्युलस (मुलभूत: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "घटानंतर जोडले जाते (मुलभूत: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "हॅश आणि श्रेणी प्रोफाइल (मुलभूत: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "ही मदत दाखवा आणि बाहेर पडा\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "आवृत्ती दाखवा आणि बाहेर पडा\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "प्रत्येक आउटपुट ओळ:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "प्रोफाइल:"

#: src/naan.c:81
msgid "default"
msgstr "मुलभूत"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV आणि BIAS दशमान किंवा 0x षोडशमान स्वीकारतात, वैकल्पिक k/m/g प्रत्ययासह (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: अवैध DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: अवैध BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: अज्ञात प्रोफाइल: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "अधिक माहितीसाठी '%s --help' वापरा.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: नाव नाही\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV 0 पेक्षा मोठे असावे\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: '%s' ची संख्या काढता आली नाही\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: लेखन त्रुटी\n"
