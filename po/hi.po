#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "लाइसेंस AGPL-3.0-or-later: GNU AGPL संस्करण 3 या बाद का"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "प्रयोग: %s [विकल्प]... नाम...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "प्रत्येक नाम से एक संख्या निकालता है।"

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "MD5 से हैश करें\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "SHA-1 से हैश करें\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "SHA-224 से हैश करें\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "SHA-256 से हैश करें (पूर्वनिर्धारित)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "SHA-384 से हैश करें\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "SHA-512 से हैश करें\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "SHA3-256 से हैश करें\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "SHA3-512 से हैश करें\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "BLAKE2s से हैश करें\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "BLAKE2b से हैश करें\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "RIPEMD-160 से हैश करें\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "CRC-16 डाइजेस्ट\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "CRC-32 डाइजेस्ट\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "मापांक (पूर्वनिर्धारित: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "अपचयन के बाद जोड़ा जाता है (पूर्वनिर्धारित: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "हैश और सीमा प्रोफ़ाइल (डिफ़ॉल्ट: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "यह सहायता दिखाएँ और निकलें\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "संस्करण दिखाएँ और निकलें\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "प्रत्येक आउटपुट पंक्ति:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "प्रोफ़ाइल:"

#: src/naan.c:81
msgid "default"
msgstr "पूर्वनिर्धारित"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV और BIAS दशमलव या 0x षोडश आधार स्वीकार करते हैं, वैकल्पिक k/m/g प्रत्यय (1024) के साथ।"

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: अमान्य DIV: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: अमान्य BIAS: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: अज्ञात प्रोफ़ाइल: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "अधिक जानकारी के लिए '%s --help' आज़माएँ।\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: नाम अनुपस्थित\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV 0 से बड़ा होना चाहिए\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: '%s' की संख्या नहीं निकल सकी\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: लिखने में त्रुटि\n"
