msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licenza AGPL-3.0-or-later: GNU AGPL versione 3 o successiva"

msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Uso: %s [OPZIONE]... NOME...\n"

msgid "Compute a number from each name."
msgstr "Calcola un numero da ciascun nome."

msgid "  -5, --md5           hash with MD5"
msgstr "  -5, --md5           calcola l'hash con MD5"

msgid "  -1, --sha1          hash with SHA-1"
msgstr "  -1, --sha1          calcola l'hash con SHA-1"

msgid "      --sha224        hash with SHA-224"
msgstr "      --sha224        calcola l'hash con SHA-224"

msgid "  -2, --sha256        hash with SHA-256 (default)"
msgstr "  -2, --sha256        calcola l'hash con SHA-256 (predefinito)"

msgid "      --sha384        hash with SHA-384"
msgstr "      --sha384        calcola l'hash con SHA-384"

msgid "  -8, --sha512        hash with SHA-512"
msgstr "  -8, --sha512        calcola l'hash con SHA-512"

msgid "  -3, --sha3-256      hash with SHA3-256"
msgstr "  -3, --sha3-256      calcola l'hash con SHA3-256"

msgid "      --sha3-512      hash with SHA3-512"
msgstr "      --sha3-512      calcola l'hash con SHA3-512"

msgid "      --blake2s       hash with BLAKE2s"
msgstr "      --blake2s       calcola l'hash con BLAKE2s"

msgid "      --blake2b       hash with BLAKE2b"
msgstr "      --blake2b       calcola l'hash con BLAKE2b"

msgid "      --ripemd160     hash with RIPEMD-160"
msgstr "      --ripemd160     calcola l'hash con RIPEMD-160"

msgid "      --crc16         digest with CRC-16"
msgstr "      --crc16         digest con CRC-16"

msgid "  -c, --crc32         digest with CRC-32"
msgstr "  -c, --crc32         digest con CRC-32"

msgid "  -m, --mod DIV       modulus (default: 65536)"
msgstr "  -m, --mod DIV       modulo (predefinito: 65536)"

msgid "  -b, --bias BIAS     added after reduction (default: 0)"
msgstr "  -b, --bias BIAS     aggiunto dopo la riduzione (predefinito: 0)"

msgid "  -p, --profile NAME  hash and range profile (default: w)"
msgstr "  -p, --profile NAME  profilo hash e intervallo (predefinito: w)"

msgid "  -h, --help          display this help and exit"
msgstr "  -h, --help          mostra questo aiuto ed esce"

msgid "      --version       output version information and exit"
msgstr "      --version       mostra la versione ed esce"

msgid "Each output line is:"
msgstr "Ogni riga di output è:"

msgid "Profiles:"
msgstr "Profili:"

msgid "default"
msgstr "predefinito"

msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV e BIAS accettano decimale o esadecimale 0x, con suffisso k/m/g opzionale (1024)."

msgid "Try '%s --help' for more information.\n"
msgstr "Provare « %s --help » per ulteriori informazioni.\n"

msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV non valido: %s\n"

msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS non valido: %s\n"

msgid "%s: unknown profile: %s\n"
msgstr "%s: profilo sconosciuto: %s\n"

msgid "%s: missing name\n"
msgstr "%s: nome mancante\n"

msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV deve essere maggiore di 0\n"

msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: impossibile calcolare il numero per « %s »\n"

msgid "%s: write error\n"
msgstr "%s: errore di scrittura\n"
