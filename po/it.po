#: src/naan.c:32
msgid "License AGPL-3.0-or-later: GNU AGPL version 3 or later"
msgstr "Licenza AGPL-3.0-or-later: GNU AGPL versione 3 o successiva"

#: src/naan.c:36
#, c-format
msgid "Usage: %s [OPTION]... NAME...\n"
msgstr "Uso: %s [OPZIONE]... NOME...\n"

#: src/naan.c:37
msgid "Compute a number from each name."
msgstr "Calcola un numero da ciascun nome."

#: src/naan.c:40
msgid "hash with MD5\n"
msgstr "calcola l'hash con MD5\n"

#: src/naan.c:42
msgid "hash with SHA-1\n"
msgstr "calcola l'hash con SHA-1\n"

#: src/naan.c:44
msgid "hash with SHA-224\n"
msgstr "calcola l'hash con SHA-224\n"

#: src/naan.c:46
msgid "hash with SHA-256 (default)\n"
msgstr "calcola l'hash con SHA-256 (predefinito)\n"

#: src/naan.c:48
msgid "hash with SHA-384\n"
msgstr "calcola l'hash con SHA-384\n"

#: src/naan.c:50
msgid "hash with SHA-512\n"
msgstr "calcola l'hash con SHA-512\n"

#: src/naan.c:52
msgid "hash with SHA3-256\n"
msgstr "calcola l'hash con SHA3-256\n"

#: src/naan.c:54
msgid "hash with SHA3-512\n"
msgstr "calcola l'hash con SHA3-512\n"

#: src/naan.c:56
msgid "hash with BLAKE2s\n"
msgstr "calcola l'hash con BLAKE2s\n"

#: src/naan.c:58
msgid "hash with BLAKE2b\n"
msgstr "calcola l'hash con BLAKE2b\n"

#: src/naan.c:60
msgid "hash with RIPEMD-160\n"
msgstr "calcola l'hash con RIPEMD-160\n"

#: src/naan.c:62
msgid "digest with CRC-16\n"
msgstr "digest con CRC-16\n"

#: src/naan.c:64
msgid "digest with CRC-32\n"
msgstr "digest con CRC-32\n"

#: src/naan.c:66
msgid "modulus (default: 65536)\n"
msgstr "modulo (predefinito: 65536)\n"

#: src/naan.c:68
msgid "added after reduction (default: 0)\n"
msgstr "aggiunto dopo la riduzione (predefinito: 0)\n"

#: src/naan.c:70
msgid "hash and range profile (default: w)\n"
msgstr "profilo hash e intervallo (predefinito: w)\n"

#: src/naan.c:72
msgid "display this help and exit\n"
msgstr "mostra questo aiuto ed esce\n"

#: src/naan.c:74
msgid "output version information and exit\n"
msgstr "mostra la versione ed esce\n"

#: src/naan.c:76
msgid "Each output line is:"
msgstr "Ogni riga di output è:"

#: src/naan.c:79
msgid "Profiles:"
msgstr "Profili:"

#: src/naan.c:81
msgid "default"
msgstr "predefinito"

#: src/naan.c:85
msgid "DIV and BIAS accept decimal or 0x hex, with optional k/m/g suffix (1024)."
msgstr "DIV e BIAS accettano decimale o esadecimale 0x, con suffisso k/m/g opzionale (1024)."

#: src/naan.c:167
#, c-format
msgid "%s: invalid DIV: %s\n"
msgstr "%s: DIV non valido: %s\n"

#: src/naan.c:173
#, c-format
msgid "%s: invalid BIAS: %s\n"
msgstr "%s: BIAS non valido: %s\n"

#: src/naan.c:179
#, c-format
msgid "%s: unknown profile: %s\n"
msgstr "%s: profilo sconosciuto: %s\n"

#: src/naan.c:190 src/naan.c:197
#, c-format
msgid "Try '%s --help' for more information.\n"
msgstr "Provare « %s --help » per ulteriori informazioni.\n"

#: src/naan.c:196
#, c-format
msgid "%s: missing name\n"
msgstr "%s: nome mancante\n"

#: src/naan.c:202
#, c-format
msgid "%s: DIV must be greater than 0\n"
msgstr "%s: DIV deve essere maggiore di 0\n"

#: src/naan.c:211
#, c-format
msgid "%s: failed to compute number for '%s'\n"
msgstr "%s: impossibile calcolare il numero per « %s »\n"

#: src/naan.c:216 src/naan.c:222
#, c-format
msgid "%s: write error\n"
msgstr "%s: errore di scrittura\n"
